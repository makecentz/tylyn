# Postgres connection (Neon on Vercel, or any Postgres)
DATABASE_URL="postgresql://user:password@host:5432/tylyn"

# Admin login
ADMIN_EMAIL="owner@example.com"
# Generate with: npm run hash-password -- "your-password"
# In a .env file every $ in the hash must be written as \$ (the script prints it that way).
ADMIN_PASSWORD_HASH=""
# Long random string used to sign admin sessions (openssl rand -base64 32)
AUTH_SECRET=""

# Square (developer.squareup.com > your app). Use sandbox values until launch.
SQUARE_ENVIRONMENT="sandbox"            # sandbox | production
SQUARE_ACCESS_TOKEN=""
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
# Webhook subscription signature key + the exact URL you registered (https://yourdomain.com/api/square/webhook)
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL=""
# Optional sales tax applied to online orders, e.g. "6" for 6%
SALES_TAX_PERCENT=""
# Optional flat shipping rate in dollars, e.g. "12.50". Leave empty to offer pickup only.
SHIPPING_FLAT_RATE=""

# Image uploads (Vercel Blob). Without it, uploads are saved to public/uploads in development only.
BLOB_READ_WRITE_TOKEN=""

# Order emails (optional, resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Tylyn Tingz Creations <orders@yourdomain.com>"
OWNER_NOTIFY_EMAIL=""

# Public site URL, used in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
